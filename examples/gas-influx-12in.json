{
  "name": "12-1/4 in section — gas influx while drilling",
  "context": {
    "hole": "12-1/4 in",
    "tvd_ft": 10000,
    "mud_weight_ppg": 12.0,
    "shoe_tvd_ft": 5000,
    "frac_gradient_ppg": 14.5,
    "slow_circulating_rate_psi": 500,
    "note": "Shoe at 5,000 ft TVD sets MAASP. All limits are package defaults: site_validated is false."
  },
  "steps": [
    {
      "id": "01 flow-out is clean",
      "tool": "qse_score_sample",
      "args": { "channel": "flow_out", "value": 640.0, "samples_in_window": 60 },
      "expect": {
        "unit": "gpm",
        "quality_score": 1.0,
        "flags": ["OK"],
        "is_actionable": true
      }
    },
    {
      "id": "02 pit volume is out of sequence - do not interpret it",
      "tool": "qse_score_sample",
      "args": {
        "channel": "pit_volume", "value": 780.0,
        "sequence_number": 41, "last_sequence": 44, "samples_in_window": 60
      },
      "expect": {
        "quality_score": 0.4,
        "flags": ["OUT_OF_SEQUENCE"],
        "is_actionable": false
      },
      "why": "Below the 0.95 floor the correct answer is the defect, never the value."
    },
    {
      "id": "03 early influx - alert, not emergency",
      "tool": "well_control_assess",
      "args": { "pit_gain_bbl": 1.2, "flow_diff_gpm": 4.0, "gas_units_pct": 2.0, "pwd_residual_sigma": 1.0 },
      "expect": {
        "kick_probability": 0.7622,
        "alert_level": 3,
        "alert_name": "Well Control Alert",
        "classification": "GAS_KICK",
        "regulatory_notification_required": true
      }
    },
    {
      "id": "04 influx escalates - emergency level",
      "tool": "well_control_assess",
      "args": { "pit_gain_bbl": 4.0, "flow_diff_gpm": 12.0, "gas_units_pct": 3.5, "pwd_residual_sigma": 1.8 },
      "expect": {
        "kick_probability": 0.9779,
        "alert_level": 4,
        "alert_name": "Emergency Shut-In Proposal",
        "classification": "GAS_KICK",
        "regulatory_notification_required": true
      },
      "why": "Level 5 (Blowout Risk) is defined upstream but unreachable: the ladder caps at 4."
    },
    {
      "id": "05 MAASP at the shoe",
      "tool": "compute",
      "args": {
        "formula": "maasp_psi",
        "arguments": { "max_mud_weight_ppg": 14.5, "current_mud_weight_ppg": 12.0, "shoe_tvd_ft": 5000.0 }
      },
      "expect": { "value": 650.0, "unit": "psi" }
    },
    {
      "id": "06 kill mud weight",
      "tool": "compute",
      "args": {
        "formula": "kill_mud_weight_ppg",
        "arguments": { "current_mud_weight_ppg": 12.0, "sidpp_psi": 260.0, "tvd_ft": 10000.0 }
      },
      "expect": { "value": 12.5, "unit": "ppg" }
    },
    {
      "id": "07 initial circulating pressure",
      "tool": "compute",
      "args": {
        "formula": "initial_circulating_pressure_psi",
        "arguments": { "sidpp_psi": 260.0, "slow_circulating_rate_psi": 500.0 }
      },
      "expect": { "value": 760.0, "unit": "psi" }
    },
    {
      "id": "08 final circulating pressure",
      "tool": "compute",
      "args": {
        "formula": "final_circulating_pressure_psi",
        "arguments": { "slow_circulating_rate_psi": 500.0, "kill_mud_weight_ppg": 12.5, "current_mud_weight_ppg": 12.0 }
      },
      "expect": { "value": 520.8333, "unit": "psi" }
    },
    {
      "id": "09 kill mud weight sits inside the window",
      "tool": "check_safety_envelope",
      "args": { "parameters": { "ecd": 12.5 }, "confidence": 0.95 },
      "expect": { "passed": true, "hard_violation": false, "site_validated": false }
    },
    {
      "id": "10 a heavier mud than the window is a hard stop",
      "tool": "check_safety_envelope",
      "args": { "parameters": { "ecd": 15.2 }, "confidence": 0.95 },
      "expect": { "passed": false, "hard_violation": true },
      "expect_contains": { "violations": "outside MWW" },
      "why": "15.2 ppg is above the 14.5 ppg frac gradient: not a trade-off, a violation."
    },
    {
      "id": "11 same WOB passes when there is no influx",
      "tool": "check_safety_envelope",
      "args": { "parameters": { "wob": 32.0 }, "confidence": 0.95 },
      "expect": { "passed": true, "hard_violation": false }
    },
    {
      "id": "12 same WOB is blocked during the influx",
      "tool": "check_safety_envelope",
      "args": { "parameters": { "wob": 32.0 }, "confidence": 0.95, "kick_probability": 0.98 },
      "expect": { "passed": false, "hard_violation": false },
      "expect_contains": { "violations": "autonomy ceiling" },
      "why": "Blocked, but not a hard violation: the gate demotes rather than forbids."
    },
    {
      "id": "13 routing at normal confidence",
      "tool": "route_autonomy",
      "args": { "level": 2, "confidence": 0.95 },
      "expect": { "routing": "auto_execute", "pack_executes": false }
    },
    {
      "id": "14 routing when confidence collapses",
      "tool": "route_autonomy",
      "args": { "level": 4, "confidence": 0.60 },
      "expect": { "routing": "advisory_only", "pack_executes": false }
    },
    {
      "id": "15 tier-1 safety outranks tier-4 confidence",
      "tool": "negotiate",
      "args": {
        "proposals": [
          { "proposal_id": "p0", "agent_id": "drilling-optimization-agent", "priority_tier": 4, "confidence": 0.95, "parameters": { "wob": 32.0 } },
          { "proposal_id": "p1", "agent_id": "well-control-monitoring-agent", "priority_tier": 1, "confidence": 0.80, "action_type": "parameter_change", "parameters": { "mud_weight_ppg": 12.5 } }
        ]
      },
      "expect": { "outcome": "CONSENSUS", "winner.agent_id": "well-control-monitoring-agent" },
      "why": "Only parameter_change proposals are arbitrated: an alert escalates on its own and never competes for the parameter slot. Confidence 0.95 loses to tier 1."
    },
    {
      "id": "16 a veto re-enters with a safer alternative",
      "tool": "negotiate",
      "args": {
        "proposals": [
          { "proposal_id": "p0", "agent_id": "drilling-optimization-agent", "priority_tier": 4, "confidence": 0.95, "parameters": { "wob": 32.0 } }
        ],
        "vetoes": [
          {
            "by_agent": "stuck-pipe-prevention-agent", "priority_tier": 2, "target_proposal_id": "p0",
            "reason": "risk 72/100", "suggested_parameters": { "wob": 29.0, "rpm": 130.0 }
          }
        ]
      },
      "expect": {
        "outcome": "CONSENSUS",
        "winner.agent_id": "stuck-pipe-prevention-agent",
        "winner.parameters.wob": 29.0,
        "winner.parameters.rpm": 130.0
      },
      "why": "The safer parameters re-enter the round and win; the rejected proposal is recorded."
    },
    {
      "id": "17 the pack refuses to claim execution authority",
      "tool": "list_capabilities",
      "args": {},
      "expect": {
        "envelope_site_validated": false,
        "limits_are_baseline_defaults_not_site_limits": true,
        "formulas_available": 31
      },
      "expect_contains": { "boundary": "Advisory only" }
    }
  ]
}
