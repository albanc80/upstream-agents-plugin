{
  "mcpServers": {
    "advisory-core": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--script",
        "${CLAUDE_PLUGIN_ROOT}/servers/advisory_core/main.py"
      ],
      "env": {
        "PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}",
        "ADVISORY_DATA_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
